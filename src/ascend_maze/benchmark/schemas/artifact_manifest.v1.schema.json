{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ascend-maze.local/schemas/artifact_manifest.v1.schema.json",
  "title": "Ascend-Maze ArtifactManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "trial_attempt_id", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^study_[0-9a-f]{32}$"},
    "trial_attempt_id": {"type": "string", "pattern": "^trial_attempt_[0-9a-f]{32}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["logical_name", "source", "size_bytes", "sha256"],
        "properties": {
          "logical_name": {"type": "string", "minLength": 1}, "source": {"enum": ["c8", "baseline", "derived"]},
          "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
