{
  "schema": "maze-playground-bundle",
  "version": 3,
  "description": "Read an uploaded image, answer with a routed multimodal model, and expose the result.",
  "tags": [
    "GAIA",
    "vision",
    "artifact",
    "VLM"
  ],
  "workflow": {
    "name": "GAIA Vision",
    "description": "Read an uploaded image, answer with a routed multimodal model, and expose the result.",
    "tags": [
      "GAIA",
      "vision",
      "artifact",
      "VLM"
    ],
    "nodes": [
      {
        "id": "image",
        "type": "taskNode",
        "position": {
          "x": 80,
          "y": 220
        },
        "data": {
          "category": "workspace",
          "nodeType": "task",
          "label": "Read Image",
          "taskPath": "tasks/gaia_image_prepare.py",
          "functionName": "gaia_prepare_image",
          "inputs": [
            {
              "name": "dag_id",
              "dataType": "any",
              "source": "user",
              "value": "gaia-vision-ui"
            },
            {
              "name": "question",
              "dataType": "any",
              "source": "user",
              "value": "How many red circles are shown, and what color is the square?"
            },
            {
              "name": "supplementary_path",
              "dataType": "str",
              "source": "user",
              "value": "samples/gaia/vision/example.png"
            }
          ],
          "outputs": [
            {
              "name": "dag_id",
              "dataType": "any"
            },
            {
              "name": "question",
              "dataType": "any"
            },
            {
              "name": "image_base64",
              "dataType": "any"
            },
            {
              "name": "mime_type",
              "dataType": "any"
            },
            {
              "name": "image_feature",
              "dataType": "any"
            }
          ],
          "resources": {
            "cpu_num": 1,
            "gpu_mem": 0,
            "io_num": 0
          },
          "configured": true,
          "task_kind": "cpu"
        }
      },
      {
        "id": "vision",
        "type": "taskNode",
        "position": {
          "x": 480,
          "y": 220
        },
        "data": {
          "category": "workspace",
          "nodeType": "task",
          "label": "Multimodal Answer",
          "taskPath": "tasks/gaia_vision_answer.py",
          "functionName": "gaia_vision_answer",
          "inputs": [
            {
              "name": "dag_id",
              "dataType": "any",
              "source": "task",
              "taskSource": {
                "taskId": "image",
                "outputKey": "dag_id"
              }
            },
            {
              "name": "question",
              "dataType": "str",
              "source": "task",
              "taskSource": {
                "taskId": "image",
                "outputKey": "question"
              }
            },
            {
              "name": "image_base64",
              "dataType": "str",
              "source": "task",
              "taskSource": {
                "taskId": "image",
                "outputKey": "image_base64"
              }
            },
            {
              "name": "mime_type",
              "dataType": "str",
              "source": "task",
              "taskSource": {
                "taskId": "image",
                "outputKey": "mime_type"
              }
            }
          ],
          "outputs": [
            {
              "name": "dag_id",
              "dataType": "any"
            },
            {
              "name": "answer",
              "dataType": "any"
            }
          ],
          "resources": {
            "cpu_num": 1,
            "gpu_mem": 20480,
            "io_num": 0
          },
          "configured": true,
          "task_kind": "gpu",
          "localModel": "Qwen2.5-VL-7B-Instruct",
          "modelAnchor": {
            "local_model": "Qwen2.5-VL-7B-Instruct",
            "model_scope": "head",
            "backend": "transformers",
            "estimated_gpu_mem_mb": 20480
          }
        }
      },
      {
        "id": "output",
        "type": "taskNode",
        "position": {
          "x": 880,
          "y": 220
        },
        "data": {
          "category": "workspace",
          "nodeType": "task",
          "label": "Output Final Answer",
          "taskPath": "tasks/gaia_output_answer.py",
          "functionName": "gaia_output_answer",
          "inputs": [
            {
              "name": "dag_id",
              "dataType": "any",
              "source": "task",
              "taskSource": {
                "taskId": "vision",
                "outputKey": "dag_id"
              }
            },
            {
              "name": "answer",
              "dataType": "str",
              "source": "task",
              "taskSource": {
                "taskId": "vision",
                "outputKey": "answer"
              }
            }
          ],
          "outputs": [
            {
              "name": "dag_id",
              "dataType": "any"
            },
            {
              "name": "final_answer",
              "dataType": "any"
            }
          ],
          "resources": {
            "cpu_num": 1,
            "gpu_mem": 0,
            "io_num": 0
          },
          "configured": true,
          "task_kind": "cpu"
        }
      }
    ],
    "edges": [
      {
        "id": "edge-image-vision",
        "source": "image",
        "target": "vision"
      },
      {
        "id": "edge-vision-output",
        "source": "vision",
        "target": "output"
      }
    ]
  },
  "includedTasks": [
    {
      "relativePath": "tasks/gaia_image_prepare.py",
      "sourceId": "gaia_image_prepare.py",
      "functionName": "gaia_prepare_image",
      "displayName": "Gaia Prepare Image",
      "resources": {
        "cpu_num": 1,
        "gpu_mem": 0,
        "io_num": 0
      },
      "type": "workspace",
      "task_kind": "cpu"
    },
    {
      "relativePath": "tasks/gaia_vision_answer.py",
      "sourceId": "gaia_vision_answer.py",
      "functionName": "gaia_vision_answer",
      "displayName": "Gaia Vision Answer",
      "resources": {
        "cpu_num": 1,
        "gpu_mem": 20480,
        "io_num": 0
      },
      "type": "workspace",
      "task_kind": "gpu"
    },
    {
      "relativePath": "tasks/gaia_output_answer.py",
      "sourceId": "gaia_output_answer.py",
      "functionName": "gaia_output_answer",
      "displayName": "Gaia Output Answer",
      "resources": {
        "cpu_num": 1,
        "gpu_mem": 0,
        "io_num": 0
      },
      "type": "workspace",
      "task_kind": "cpu"
    }
  ],
  "includedFiles": [
    {
      "sourceId": "gaia/vision/example.png",
      "targetPath": "samples/gaia/vision/example.png"
    }
  ]
}
